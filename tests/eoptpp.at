AT_SETUP([pound -E (with preprocessor)])
AT_KEYWORDS([preproc eopt])
AT_CHECK([m4 < /dev/null > /dev/null 2>&1 || exit 77
m4_pattern_allow([dnl])
AT_DATA([pound.cfg],
[# pragma preprocessor m4
define(`SVC',
`Service "$1"
	Host "$2"
	Backend
		Address $3
		Port $4
	End
End')[dnl]
SVC(one, example.org, 192.0.2.1, 80)
SVC(two, foo.bar, 127.0.0.1, 8080)
])
m4_pattern_forbid([dnl])
pound -Wno-include-dir -E -f pound.cfg
],
[0],
[
Service "one"
	Host "example.org"
	Backend
		Address 192.0.2.1
		Port 80
	End
End
Service "two"
	Host "foo.bar"
	Backend
		Address 127.0.0.1
		Port 8080
	End
End
])
AT_CLEANUP

