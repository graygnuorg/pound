AT_SETUP([Early rewrites])
AT_KEYWORDS([rewrite rwearly])
PT_CHECK([ListenHTTP
	Rewrite early
		DeleteHeader "X-Known"
	End

	Rewrite early
		Header "X-Input" -beg "One"
		SetHeader "X-Known: 1"
	Else
		Header "X-Input" -beg "Two"			
		SetHeader "X-Known: 2"
	Else
		Header "^X-Input:"
		SetHeader "X-Known: 3"
	End

	Service
		Header "^X-Known:"
		Backend
		End
	End

	Service
		Backend
		End
	End
End
],
[GET /echo/foo
X-Input: one
end

200
x-backend-number: 0
x-orig-header-x-known: 1
end

GET /echo/foo
X-Input: two
end

200
x-backend-number: 0
x-orig-header-x-known: 2
end

GET /echo/foo
X-Input: three
end

200
x-backend-number: 0
x-orig-header-x-known: 3
end

GET /echo/foo
end

200
x-backend-number: 1
end
])
AT_CLEANUP
