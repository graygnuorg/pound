AT_SETUP([Preprocessing and include files])
AT_KEYWORDS([preproc ppinc])
AT_CHECK([m4 < /dev/null > /dev/null 2>&1 || exit 77
m4_pattern_allow([dnl])
AT_DATA([inc.m4],
[define(`A',`ListenHTTP
  Address 127.0.0.1
  Port 80
End')[dnl]
define(`B',`Service "b"
  Host "foo.bar"
  Backend
    Address 127.0.0.1
    Port 8081
  End
End')[dnl]
define(`C',`Service "c"
  Error 404
End')[dnl]
])

AT_DATA([pound.cfg],
[#pragma preprocessor m4
include(`inc.m4')
A
`Include' "conf.d/*.cfg"
])

mkdir conf.d

AT_DATA([conf.d/a.cfg],
[include(`inc.m4')
B
])

AT_DATA([conf.d/b.cfg],
[include(`inc.m4')
C
])

pound -Wno-include-dir -E -f ./pound.cfg
m4_pattern_forbid([dnl])
],
[0],
[

ListenHTTP
  Address 127.0.0.1
  Port 80
End
# 1 "conf.d/a.cfg"

Service "b"
  Host "foo.bar"
  Backend
    Address 127.0.0.1
    Port 8081
  End
End
# 1 "conf.d/b.cfg"

Service "c"
  Error 404
End
])

AT_CHECK([pound -Wno-include-dir -c -f ./pound.cfg])

AT_CLEANUP
