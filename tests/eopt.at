AT_SETUP([pound -E (without preprocessor)])
AT_KEYWORDS([preproc eopt])
AT_CHECK([
AT_DATA([pound.cfg],
[Include "conf.d/*.cfg"
])
mkdir conf.d
AT_DATA([conf.d/1.cfg],
[This is conf.d/1.cfg
])
AT_DATA([conf.d/2.cfg],
[This is conf.d/2.cfg
])
pound -Wno-include-dir -E -f pound.cfg
],
[0],
[# 1 "conf.d/1.cfg"
This is conf.d/1.cfg
# 1 "conf.d/2.cfg"
This is conf.d/2.cfg
])
AT_CLEANUP

