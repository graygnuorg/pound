AT_SETUP([trace control])
AT_KEYWORDS([ctl trace ctl-trace])
PT_CHECK([
Service "c"
	Host "bar"
	Backend
	End
End
ListenHTTP "L0"
	xHTTP 1
	Service "ctl"
		Match OR
			Path -beg "/core"
			Path -beg "/listener"
			Path -beg "/service"
			Path -beg "/log"
			Path -beg "/beacon"
			Path -beg "/trace"
		End
		Control
	End
	Service "a"
		Host "foo"
		Path "/a"
		Backend
		End
	End
	Service "b"
		Host "foo"
		Backend
		End
	End
End
],
[[GET /trace?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "values": \[
    \{
      "listener_no": 0,
      "service_no": 0,
      "trace": false
    \},
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "ctl",
      "service_no": 0,
      "trace": false
    \},
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "a",
      "service_no": 1,
      "trace": false
    \},
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "b",
      "service_no": 2,
      "trace": false
    \},
    \{
      "service_name": "c",
      "service_no": 0,
      "trace": false
    \}
  \]
\}
endnonl

GET /trace/L0?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "values": \[
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "ctl",
      "service_no": 0,
      "trace": false
    \},
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "a",
      "service_no": 1,
      "trace": false
    \},
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "b",
      "service_no": 2,
      "trace": false
    \}
  \]
\}
endnonl

GET /trace/-?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "values": \[
    \{
      "service_name": "c",
      "service_no": 0,
      "trace": false
    \}
  \]
\}
endnonl

GET /trace/-/c?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "value": \{
    "service_name": "c",
    "service_no": 0,
    "trace": false
  \}
\}
endnonl

GET /trace/1/2?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "value": \{
    "listener_name": "L0",
    "listener_no": 1,
    "service_name": "b",
    "service_no": 2,
    "trace": false
  \}
\}
endnonl

PUT /trace/1/2?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "value": \{
    "listener_name": "L0",
    "listener_no": 1,
    "service_name": "b",
    "service_no": 2,
    "trace": true
  \}
\}
endnonl

DELETE /trace/1/2?indent=2
end

200
Content-Type: application/json

:re
\{
