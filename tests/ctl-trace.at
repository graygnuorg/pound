    "listener_name": "L0",
    "listener_no": 1,
    "service_name": "b",
    "service_no": 2,
    "trace": false
  \}
\}
endnonl

PUT /trace/L0?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "values": \[
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "ctl",
      "service_no": 0,
      "trace": true
    \},
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "a",
      "service_no": 1,
      "trace": true
    \},
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "b",
      "service_no": 2,
      "trace": true
    \}
  \]
\}
endnonl

DELETE /trace/L0?indent=2
end

200
Content-Type: application/json

:re
\{
  "kind": "trace",
  "values": \[
    \{
      "listener_name": "L0",
      "listener_no": 1,
      "service_name": "ctl",
      "service_no": 0,
