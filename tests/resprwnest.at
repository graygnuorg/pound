AT_SETUP([Nested response rewrites])
AT_KEYWORDS([rewrite response resprwnest])
PT_CHECK([ListenHTTP
	Service
		Rewrite response
			Header "Content-Type: text/(.+)"
			SetHeader "X-Content-SubType: $1"
		Else
			Header "Content-Type: application/(.+)"
			Rewrite
				StringMatch "$1" -exact "foo"
				SetHeader "X-App: 1"
			Else
				StringMatch "$1" -exact "bar"
				SetHeader "X-App: 2"
			Else
				SetHeader "X-App: 3"
			End
		End
		Backend
			Address
			Port
		End
	End
End
],
[GET /echo/foo
Content-Type: text/plain
end

200
x-content-subtype: plain
end

GET /echo/foo
Content-Type: application/foo
end

200
x-app: 1
end

GET /echo/foo
Content-Type: application/bar
end

200
x-app: 2
end

GET /echo/foo
Content-Type: application/quux
end

200
x-app: 3
end
])
AT_CLEANUP
