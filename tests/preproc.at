AT_SETUP([Preprocessor])
AT_KEYWORDS([preproc])
AT_CHECK([m4 -s < /dev/null > /dev/null 2>&1 || exit 77])

AT_DATA([pp],
[# Preprocessor is requested by pragma preproc line appearing
# before the first statement, like this:
#pragma preproc m4 -s
])

m4_pushdef([HARNESS_OPTIONS],[--header=@pp])
PT_CHECK(
[define(`HOST',dnl
`Rewrite
   Host -re ["(.+)--[[:digit:]]+(:[[:digit:]]+)?@S|@"]
   SetHeader "Host: @S|@`'1"
End')

ListenHTTP
	Service
		HOST
		Backend
		End
	End
End
],
[GET /echo/foo
Host: example.com--128
end

200
x-orig-header-host: example.com
end
])
m4_popdef([HARNESS_OPTIONS])
AT_CLEANUP
