AT_SETUP([Nested rewrites])
AT_KEYWORDS([rewrite rwnest])
PT_CHECK([ListenHTTP
	Service
		Rewrite
			URL -beg "/echo/foo"
			Rewrite
				Host "foo.com"
				SetHeader "X-Branch: 1"
			Else
				Host "bar.com"
				Rewrite
					Header "X-Bar" "foo"
					SetHeader "X-Branch: 2a"
				Else
					SetHeader "X-Branch: 2b"
				End
			Else
				SetHeader "X-Branch: 3"
			End
		End
		Backend
		End
	End
End
],
[GET /echo/foo/bar
Host: foo.com
end

200
x-orig-header-x-branch: 1
end

GET /echo/foo/bar
Host: bar.com
X-Bar: foo
end

200
x-orig-header-x-branch: 2a
end

GET /echo/foo/bar
Host: bar.com
X-Bar: bar
end

200
x-orig-header-x-branch: 2b
end

GET /echo/foo/bar
Host: bar.com
end

200
x-orig-header-x-branch: 2b
end

GET /echo/foo/bar
Host: bar.qux
end

200
x-orig-header-x-branch: 3
end
])
AT_CLEANUP
