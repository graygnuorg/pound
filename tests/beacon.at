AT_SETUP([Beacons])
AT_KEYWORDS([beacon poundctl])
AT_DATA([beacon.tmpl],
[{{define "default" -}}
{{range $name,$val = .beacons -}}
{{$name}} {{$val}}
{{end}}
{{- end -}}
])
PT_CHECK(
[DeclareBeacon "b1"
ListenHTTP
	Service "one"
		Beacon "b1"
		Backend
			Address
			Port
		End
	End
	Service "two"
		Backend
			Address
			Port
		End
	End
End
],
[GET /echo/foo
end

200
x-backend-number: 1
end

run poundctl -f ./pound.cfg -t ./beacon.tmpl beacon
status 0
stdout
b1 false
end
end

run poundctl -f ./pound.cfg -t ./beacon.tmpl beacon -s b1
status 0
end

GET /echo/foo
end

200
x-backend-number: 0
end

run poundctl -f ./pound.cfg -t ./beacon.tmpl beacon -d b1
status 0
end

GET /echo/foo
end

200
x-backend-number: 1
end

])
AT_CLEANUP
